// GlueSight 视觉握手 · 现场参考程序（生产通讯协议 7，S7-1200，TIA Portal V17）
// 尚未在 TIA Portal 编译。规则与状态迁移以协议 7 规格为准，导入与验收见同目录 README.md。
//
// 结构：
//   plc_send_vision（DB4，PLC 写）/ vision_send_plc（DB2，PC 写）：各 68 字节，取消“优化的块访问”。
//   GlueSightProduction：协议 7 PLC 侧状态机，只写 DB4、只读 DB2。
//   GlueSightStation   ：现场适配，调用生产与示教（teaching_v1.scl），合并 MotionPermit 与 Line0。
// 与协议 6 不兼容：两个 DB 按本文件重新生成，PC 与 PLC 成套切换。先导入 teaching_v1.scl（DB6 / DB12）。
//
// 以下接口需现场接线确认（GlueSightStation 参数中以 TODO-n 标出）：
//   TODO-0  Startup：首个扫描周期标志（OB100 置位）。
//   TODO-1  PartPresent：工件到位、机器人等待放行；本件结束后由机器人拉低。
//   TODO-2  MotionActive：机器人采集路径使能电平。
//   TODO-3  InterlockOk：现场互锁满足（急停、安全门等）。
//   TODO-4  ExecutionFault：现场执行故障（机器人报警等）。
//   TODO-5  OperatorReset / ResetPermit / SeqRestart：现场复位按钮、允许软件复位、序号耗尽后的回绕确认。
//   TODO-6  ProductCode / PartSn：型号 1–32767 与工件 SN 来源。
//   TODO-7  TeachMode / RobotReady / RobotStopped / MotionComplete：示教接口 V1 所需信号。
//   TODO-8  Line0：三台相机 Line0 输出点。
//   TODO-9  MotionPermit / SkipMotion：给机器人的放行与“拒收件不运动”信号，PC 不在线时机器人不等待的实现方式。
//   TODO-10 ResultOk / ResultNg / InspectError / Unchecked / Maintenance / PartDataInvalid / DispositionDone：
//           OK、NG、检测错误、未检的去向（HMI、输出位或 MES）。

DATA_BLOCK "plc_send_vision"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 7.0
   STRUCT
      plcVersion : Int := 7;
      plcHeartbeat : Int;
      plcState : Int := 99;
      plcReason : Int;
      requestSeq : DInt;
      productCode : Int;
      plcReserved : Int;
      sn : String[50];
   END_STRUCT;
BEGIN
END_DATA_BLOCK

DATA_BLOCK "vision_send_plc"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 7.0
   STRUCT
      pcVersion : Int;
      pcHeartbeat : Int;
      pcState : Int;
      pcMode : Int;
      seqEcho : DInt;
      resultCode : Int;
      faultCode : Int;
      snEcho : String[50];
   END_STRUCT;
BEGIN
END_DATA_BLOCK

FUNCTION_BLOCK "GlueSightProduction"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 7.0
   VAR_INPUT
      Startup : Bool;
      PartPresent : Bool;
      MotionActive : Bool;
      InterlockOk : Bool;
      ExecutionFault : Bool;
      OperatorReset : Bool;
      ResetPermit : Bool := TRUE;
      SeqRestart : Bool;
      TeachBusy : Bool;
      ProductCode : Int;
      PartSn : String[50];
      ArmTimeout : Time := T#10s;
      MotionTimeout : Time := T#30s;
      ResultTimeout : Time := T#10s;
      ReadyTimeout : Time := T#10s;
   END_VAR

   VAR_IN_OUT
      LastSeq : DInt;
   END_VAR

   VAR_OUTPUT
      State : Int := 99;
      Reason : Int;
      PcAlive : Bool;
      MotionPermit : Bool;
      SkipMotion : Bool;
      Line0 : Bool;
      PartActive : Bool;
      ResetComplete : Bool;
      ResultOk : Bool;
      ResultNg : Bool;
      InspectError : Bool;
      Unchecked : Bool;
      Maintenance : Bool;
      PartDataInvalid : Bool;
      DispositionDone : Bool;
      ResultCode : Int;
      FaultCode : Int;
   END_VAR

   VAR
      Initialized : Bool;
      PartPresentPrevious : Bool;
      OperatorResetPrevious : Bool;
      PartWaiting : Bool;
      MotionPending : Bool;
      MotionSeen : Bool;
      InFlight : Bool;
      Armed : Bool;
      Finalized : Bool;
      FrozenSeq : DInt;
      FrozenSn : String[50];
      PlcHeartbeat : Int;
      PcHeartbeatPrevious : Int;
      PcHeartbeatSeen : Bool;
      SnapshotValid : Bool;
      PrevPcVersion : Int;
      PrevPcState : Int;
      PrevPcMode : Int;
      PrevSeqEcho : DInt;
      PrevResultCode : Int;
      PrevFaultCode : Int;
      PrevSnEcho : String[50];
      Phase : Int;
      PhasePrevious : Int;
      HeartbeatTimer : IEC_TIMER;
      PcWatchdog : IEC_TIMER;
      PhaseTimer : IEC_TIMER;
      MotionTimer : IEC_TIMER;
   END_VAR

   VAR_TEMP
      CurPcVersion : Int;
      CurPcState : Int;
      CurPcMode : Int;
      CurSeqEcho : DInt;
      CurResultCode : Int;
      CurFaultCode : Int;
      CurSnEcho : String[50];
      Stable : Bool;
      PcHeartbeatChanged : Bool;
      PartArrived : Bool;
      PartLeft : Bool;
      OperatorResetEdge : Bool;
      EntryState : Int;
      Trip : Int;
      ClearTxn : Bool;
      ClearTarget : Int;
      Latch : Bool;
      CodeValid : Bool;
      PassPart : Bool;
      PassInvalid : Bool;
      GrantPermit : Bool;
      PartValid : Bool;
      NonBlank : Bool;
      SeqBase : DInt;
      PhaseLimit : Time;
      SnLength : Int;
      Index : Int;
      Ch : Char;
   END_VAR

BEGIN
   #ResetComplete := FALSE;
   #DispositionDone := FALSE;
   #Trip := 0;
   #ClearTxn := FALSE;
   #ClearTarget := 0;
   #Latch := FALSE;
   #PassPart := FALSE;
   #PassInvalid := FALSE;
   #GrantPermit := FALSE;

   IF #Startup OR NOT #Initialized THEN
      #Initialized := TRUE;
      #State := 99;
      #Reason := 0;
      #PartPresentPrevious := FALSE;
      #OperatorResetPrevious := #OperatorReset;
      #PartWaiting := FALSE;
      #MotionPending := FALSE;
      #MotionPermit := FALSE;
      #SkipMotion := FALSE;
      #InFlight := FALSE;
      #Armed := FALSE;
      #SnapshotValid := FALSE;
      #PcHeartbeatSeen := FALSE;
      #PcHeartbeatPrevious := "vision_send_plc".pcHeartbeat;
      #LastSeq := MAX(IN1 := #LastSeq, IN2 := "plc_send_vision".requestSeq);
   END_IF;

   REGION 心跳
      #HeartbeatTimer.TON(IN := NOT #HeartbeatTimer.Q, PT := T#500ms);
      IF #HeartbeatTimer.Q THEN
         IF #PlcHeartbeat >= 32767 THEN
            #PlcHeartbeat := 0;
         ELSE
            #PlcHeartbeat := #PlcHeartbeat + 1;
         END_IF;
      END_IF;
      #PcHeartbeatChanged := "vision_send_plc".pcHeartbeat <> #PcHeartbeatPrevious;
      #PcHeartbeatPrevious := "vision_send_plc".pcHeartbeat;
      IF #PcHeartbeatChanged THEN
         #PcHeartbeatSeen := TRUE;
      END_IF;
      #PcWatchdog.TON(IN := NOT #PcHeartbeatChanged, PT := T#3s);
      #PcAlive := #PcHeartbeatSeen AND NOT #PcWatchdog.Q;
   END_REGION

   REGION 双快照
      // 连续两个扫描读到的 DB2 完全一致才处理（心跳除外）
      #CurPcVersion := "vision_send_plc".pcVersion;
      #CurPcState := "vision_send_plc".pcState;
      #CurPcMode := "vision_send_plc".pcMode;
      #CurSeqEcho := "vision_send_plc".seqEcho;
      #CurResultCode := "vision_send_plc".resultCode;
      #CurFaultCode := "vision_send_plc".faultCode;
      #CurSnEcho := "vision_send_plc".snEcho;
      #Stable := #SnapshotValid
         AND (#CurPcVersion = #PrevPcVersion) AND (#CurPcState = #PrevPcState)
         AND (#CurPcMode = #PrevPcMode) AND (#CurSeqEcho = #PrevSeqEcho)
         AND (#CurResultCode = #PrevResultCode) AND (#CurFaultCode = #PrevFaultCode)
         AND (#CurSnEcho = #PrevSnEcho);
      #PrevPcVersion := #CurPcVersion;
      #PrevPcState := #CurPcState;
      #PrevPcMode := #CurPcMode;
      #PrevSeqEcho := #CurSeqEcho;
      #PrevResultCode := #CurResultCode;
      #PrevFaultCode := #CurFaultCode;
      #PrevSnEcho := #CurSnEcho;
      #SnapshotValid := TRUE;
   END_REGION

   REGION 工件与运动
      #PartArrived := #PartPresent AND NOT #PartPresentPrevious;
      #PartLeft := NOT #PartPresent AND #PartPresentPrevious;
      #PartPresentPrevious := #PartPresent;
      #OperatorResetEdge := #OperatorReset AND NOT #OperatorResetPrevious;
      #OperatorResetPrevious := #OperatorReset;

      IF #PartArrived THEN
         #PartWaiting := TRUE;
      END_IF;
      IF #MotionPending THEN
         #MotionSeen := #MotionSeen OR #MotionActive;
         IF (#MotionSeen AND NOT #MotionActive) OR #PartLeft THEN
            #MotionPending := FALSE;
         END_IF;
      END_IF;
      IF #PartLeft THEN
         #PartWaiting := FALSE;
         #MotionPermit := FALSE;
         #SkipMotion := FALSE;
      END_IF;
      #MotionTimer.TON(IN := #MotionPending, PT := #MotionTimeout);
   END_REGION

   REGION 阶段计时
      #Phase := 0;
      #PhaseLimit := #ArmTimeout;
      IF (#State = 10) AND NOT #Armed THEN
         #Phase := 1;
      ELSIF #State = 20 THEN
         #Phase := 2;
         #PhaseLimit := #ResultTimeout;
      ELSIF #State = 30 THEN
         #Phase := 3;
         #PhaseLimit := #ReadyTimeout;
      END_IF;
      #PhaseTimer.TON(IN := (#Phase <> 0) AND (#Phase = #PhasePrevious), PT := #PhaseLimit);
      #PhasePrevious := #Phase;
   END_REGION

   #EntryState := #State;

   IF #MotionPending AND #MotionTimer.Q THEN
      #MotionPending := FALSE;
      IF #State <> 90 THEN
         #Trip := 7;
      END_IF;
   END_IF;

   IF #Trip = 0 THEN
      CASE #State OF
         0:
            IF #Stable AND #PcAlive AND ((#CurPcState = 20) OR (#CurPcState = 30)
               OR ((#CurPcState = 10) AND (#CurPcVersion <> 7))) THEN
               #Trip := 5;
            ELSIF #PartWaiting THEN
               IF #Stable AND #PcAlive AND (#CurPcState = 10) AND NOT #TeachBusy THEN
                  #SnLength := LEN(#PartSn);
                  #PartValid := (#ProductCode >= 1) AND (#SnLength >= 1) AND (#SnLength <= 50);
                  #NonBlank := FALSE;
                  IF #PartValid THEN
                     FOR #Index := 1 TO #SnLength DO
                        #Ch := #PartSn[#Index];
                        IF (#Ch < ' ') OR (#Ch > '~') THEN
                           #PartValid := FALSE;
                        END_IF;
                        IF #Ch <> ' ' THEN
                           #NonBlank := TRUE;
                        END_IF;
                     END_FOR;
                  END_IF;
                  IF NOT #PartValid OR NOT #NonBlank THEN
                     #PassPart := TRUE;
                     #PassInvalid := TRUE;
                  ELSE
                     #SeqBase := MAX(IN1 := #LastSeq, IN2 := "plc_send_vision".requestSeq);
                     IF #SeqBase < DINT#0 THEN
                        #SeqBase := DINT#0;
                     END_IF;
                     IF #SeqBase >= DINT#2147483647 THEN
                        #Trip := 12;
                     ELSE
                        #FrozenSeq := #SeqBase + DINT#1;
                        #LastSeq := #FrozenSeq;
                        #FrozenSn := #PartSn;
                        "plc_send_vision".requestSeq := #FrozenSeq;
                        "plc_send_vision".productCode := #ProductCode;
                        "plc_send_vision".sn := #FrozenSn;
                        #InFlight := TRUE;
                        #Armed := FALSE;
                        #Finalized := FALSE;
                        #ResultOk := FALSE;
                        #ResultNg := FALSE;
                        #InspectError := FALSE;
                        #Unchecked := FALSE;
                        #Maintenance := FALSE;
                        #PartDataInvalid := FALSE;
                        #ResultCode := 0;
                        #FaultCode := 0;
                        #State := 10;
                     END_IF;
                  END_IF;
               ELSE
                  #PassPart := TRUE;
               END_IF;
            END_IF;

         10:
            IF NOT #PcAlive THEN
               #Trip := 6;
            ELSIF #ExecutionFault THEN
               #Trip := 9;
            ELSIF #Stable AND ((#CurPcState = 0) OR (#CurPcState = 90)) THEN
               #Trip := 14;
            ELSIF #Stable AND (#CurPcState = 99) THEN
               #ClearTxn := TRUE;
            ELSIF #Stable AND (#CurPcVersion <> 7) THEN
               #Trip := 5;
            ELSIF #Armed THEN
               IF #Stable AND ((#CurPcState <> 20) OR (#CurSeqEcho <> #FrozenSeq)) THEN
                  #Trip := 5;
               ELSIF #MotionPending AND NOT #InterlockOk THEN
                  #Trip := 4;
               ELSIF NOT #MotionPending THEN
                  #State := 20;
               END_IF;
            ELSIF NOT #PartWaiting THEN
               #Trip := 9;
            ELSIF #Stable AND (#CurPcState = 20) THEN
               IF #CurSeqEcho <> #FrozenSeq THEN
                  #Trip := 5;
               ELSE
                  #Armed := TRUE;
                  #GrantPermit := TRUE;
               END_IF;
            ELSIF #Stable AND (#CurPcState = 30) THEN
               #Latch := TRUE;
            ELSIF #Stable AND (#CurPcState <> 10) THEN
               #Trip := 5;
            ELSIF #PhaseTimer.Q THEN
               #Trip := 11;
            END_IF;

         20:
            IF NOT #PcAlive THEN
               #Trip := 6;
            ELSIF #Stable AND ((#CurPcState = 0) OR (#CurPcState = 90)) THEN
               #Trip := 14;
            ELSIF #Stable AND (#CurPcState = 99) THEN
               #ClearTxn := TRUE;
            ELSIF #Stable AND (#CurPcVersion <> 7) THEN
               #Trip := 5;
            ELSIF #Stable AND (#CurPcState = 30) THEN
               #Latch := TRUE;
            ELSIF #Stable AND ((#CurPcState <> 20) OR (#CurSeqEcho <> #FrozenSeq)) THEN
               #Trip := 5;
            ELSIF #PhaseTimer.Q THEN
               #Trip := 8;
            END_IF;

         30:
            IF NOT #PcAlive THEN
               #Trip := 6;
            ELSIF #Stable AND ((#CurPcState = 0) OR (#CurPcState = 90)) THEN
               #Trip := 14;
            ELSIF #Stable AND ((#CurPcState = 10) OR (#CurPcState = 99)) THEN
               #ClearTxn := TRUE;
            ELSIF #Stable AND ((#CurPcVersion <> 7) OR (#CurPcState <> 30)
               OR (#CurSeqEcho <> #FrozenSeq) OR (#CurSnEcho <> #FrozenSn)) THEN
               #Trip := 5;
            ELSIF #PhaseTimer.Q THEN
               #Trip := 10;
            END_IF;

         90:
            IF #OperatorResetEdge THEN
               #ClearTxn := TRUE;
               #ClearTarget := 99;
            ELSIF #Stable AND #PcAlive AND (#CurPcState = 99) THEN
               IF #ResetPermit AND NOT #ExecutionFault THEN
                  #ClearTxn := TRUE;
               ELSE
                  #Reason := 13;
               END_IF;
            END_IF;
            IF #PartWaiting AND NOT #ClearTxn THEN
               #PassPart := TRUE;
            END_IF;

         99:
            IF #Stable AND #PcAlive AND (#CurPcState = 10) AND (#CurPcVersion <> 7) THEN
               #Trip := 5;
            ELSIF #Stable AND #PcAlive AND ((#CurPcState = 10) OR (#CurPcState = 99)) THEN
               #ClearTxn := TRUE;
            ELSIF #PartWaiting THEN
               #PassPart := TRUE;
            END_IF;

         ELSE
            #Trip := 5;
      END_CASE;
   END_IF;

   REGION 锁存结果
      // 维护模式取值在锁存时读取；拒收（未布防即置 30）只接受检测错误
      IF #Latch THEN
         IF (#CurSeqEcho <> #FrozenSeq) OR (#CurSnEcho <> #FrozenSn) THEN
            #Trip := 5;
         ELSIF #CurPcMode = 1 THEN
            #Unchecked := TRUE;
            #Maintenance := TRUE;
         ELSIF #CurPcMode <> 0 THEN
            #Trip := 5;
         ELSE
            #CodeValid := FALSE;
            CASE #CurResultCode OF
               1, 2, 11..14:
                  #CodeValid := (#CurFaultCode = 0) AND (#EntryState = 20);
               90:
                  #CodeValid := (#CurFaultCode >= 91) AND (#CurFaultCode <= 100);
            END_CASE;
            IF #CodeValid THEN
               #ResultCode := #CurResultCode;
               #FaultCode := #CurFaultCode;
               #ResultOk := (#CurResultCode = 1) OR (#CurResultCode = 2);
               #ResultNg := (#CurResultCode >= 11) AND (#CurResultCode <= 14);
               #InspectError := #CurResultCode = 90;
            ELSE
               #Trip := 5;
            END_IF;
         END_IF;
         IF #Trip = 0 THEN
            #Finalized := TRUE;
            #DispositionDone := TRUE;
            IF #EntryState = 10 THEN
               #PartWaiting := FALSE;
               #SkipMotion := TRUE;
            END_IF;
            #State := 30;
         END_IF;
      END_IF;
   END_REGION

   REGION 故障与复位
      // 在途件未出结果记未检；未放行的本件照常放行，不打断已在运动的机器人
      IF (#Trip <> 0) OR #ClearTxn THEN
         IF #InFlight AND NOT #Finalized THEN
            #Finalized := TRUE;
            #Unchecked := TRUE;
            #DispositionDone := TRUE;
         END_IF;
         IF (#EntryState = 10) AND NOT #Armed AND #PartWaiting THEN
            #GrantPermit := TRUE;
         END_IF;
      END_IF;
      IF #Trip <> 0 THEN
         #State := 90;
         #Reason := #Trip;
      ELSIF #ClearTxn THEN
         #InFlight := FALSE;
         #Armed := FALSE;
         IF #ClearTarget = 0 THEN
            IF #SeqRestart AND ((#EntryState = 90) OR (#EntryState = 99)) THEN
               #LastSeq := DINT#0;
               "plc_send_vision".requestSeq := DINT#0;
            END_IF;
            #ResetComplete := NOT ((#EntryState = 30) AND (#CurPcState = 10));
         END_IF;
         #State := #ClearTarget;
         #Reason := 0;
      END_IF;
   END_REGION

   REGION 放行
      IF #PassPart THEN
         #ResultOk := FALSE;
         #ResultNg := FALSE;
         #InspectError := FALSE;
         #Maintenance := FALSE;
         #ResultCode := 0;
         #FaultCode := 0;
         #Unchecked := TRUE;
         #PartDataInvalid := #PassInvalid;
         #DispositionDone := TRUE;
         #GrantPermit := TRUE;
      END_IF;
      IF #GrantPermit THEN
         #PartWaiting := FALSE;
         #MotionPermit := TRUE;
         #MotionPending := TRUE;
         #MotionSeen := FALSE;
      END_IF;
   END_REGION

   REGION 输出
      #Line0 := (#State = 10) AND #Armed AND #MotionPending
         AND ("vision_send_plc".pcState = 20)
         AND ("vision_send_plc".seqEcho = "plc_send_vision".requestSeq)
         AND #PcAlive AND #InterlockOk AND #MotionActive;
      #PartActive := #PartWaiting OR #MotionPermit OR #SkipMotion;
      // 先写数据，最后写状态
      "plc_send_vision".plcVersion := 7;
      "plc_send_vision".plcHeartbeat := #PlcHeartbeat;
      "plc_send_vision".plcReserved := 0;
      "plc_send_vision".plcReason := #Reason;
      "plc_send_vision".plcState := #State;
   END_REGION
END_FUNCTION_BLOCK

FUNCTION_BLOCK "GlueSightStation"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 7.0
   VAR_INPUT
      Startup : Bool;                  // TODO-0
      PartPresent : Bool;              // TODO-1
      MotionActive : Bool;             // TODO-2
      InterlockOk : Bool;              // TODO-3
      ExecutionFault : Bool;           // TODO-4
      OperatorReset : Bool;            // TODO-5
      ResetPermit : Bool := TRUE;      // TODO-5
      SeqRestart : Bool;               // TODO-5
      ProductCode : Int;               // TODO-6
      PartSn : String[50];             // TODO-6
      TeachMode : Bool;                // TODO-7
      RobotReady : Bool;               // TODO-7
      RobotStopped : Bool;             // TODO-7
      MotionComplete : Bool;           // TODO-7
      ArmTimeout : Time := T#10s;      // 不小于 PC 布防预算 + 2 s
      MotionTimeout : Time := T#30s;
      ResultTimeout : Time := T#10s;
      ReadyTimeout : Time := T#10s;
   END_VAR

   VAR_OUTPUT
      Line0 : Bool;                    // TODO-8
      MotionPermit : Bool;             // TODO-9
      SkipMotion : Bool;               // TODO-9
      ResultOk : Bool;                 // TODO-10
      ResultNg : Bool;
      InspectError : Bool;
      Unchecked : Bool;
      Maintenance : Bool;
      PartDataInvalid : Bool;
      DispositionDone : Bool;
      ResultCode : Int;
      FaultCode : Int;
      PlcState : Int;
      PlcReason : Int;
      PcAlive : Bool;
      VisionAlarm : Bool;
      CaptureComplete : Bool;
      CaptureFailed : Bool;
      TeachState : Int;
      TeachReason : Int;
   END_VAR

   VAR
      Production : "GlueSightProduction";
      Teaching : "GlueSightTeaching";
      PartPresentPrevious : Bool;
   END_VAR

   VAR RETAIN
      LastSeq : DInt;
      LastTeachRoundId : Int;
   END_VAR

   VAR_TEMP
      PartArrived : Bool;
   END_VAR

BEGIN
   #PartArrived := #PartPresent AND NOT #PartPresentPrevious;
   #PartPresentPrevious := #PartPresent;

   // 示教占用（DB12 状态非 0）时不提交生产请求，来件按未检放行
   #Production(Startup := #Startup,
               PartPresent := #PartPresent,
               MotionActive := #MotionActive,
               InterlockOk := #InterlockOk,
               ExecutionFault := #ExecutionFault,
               OperatorReset := #OperatorReset,
               ResetPermit := #ResetPermit,
               SeqRestart := #SeqRestart,
               TeachBusy := "teach_plc".teachPlcState <> 0,
               ProductCode := #ProductCode,
               PartSn := #PartSn,
               ArmTimeout := #ArmTimeout,
               MotionTimeout := #MotionTimeout,
               ResultTimeout := #ResultTimeout,
               ReadyTimeout := #ReadyTimeout,
               LastSeq := #LastSeq);

   // plcState 非 0 或生产件未离开时不接受示教
   #Teaching(Startup := #Startup,
             BaseResetComplete := #Production.ResetComplete,
             BaseResetting := #Production.State = 99,
             BaseReady := #Production.State = 0,
             PcAlive := #Production.PcAlive,
             TeachPermit := #TeachMode,
             RobotReady := #RobotReady,
             RobotStopped := #RobotStopped,
             ProductionBusy := (#Production.State <> 0) OR #Production.PartActive,
             ProductionRequest := #PartArrived,
             MotionActive := #MotionActive,
             MotionComplete := #MotionComplete,
             ExternalFault := #ExecutionFault OR NOT #InterlockOk,
             LastRoundId := #LastTeachRoundId);

   #Line0 := #Production.Line0
      OR (#Teaching.TriggerPermit AND #InterlockOk AND NOT #ExecutionFault);
   #MotionPermit := #Production.MotionPermit OR #Teaching.MotionPermit;
   #SkipMotion := #Production.SkipMotion;
   #ResultOk := #Production.ResultOk;
   #ResultNg := #Production.ResultNg;
   #InspectError := #Production.InspectError;
   #Unchecked := #Production.Unchecked;
   #Maintenance := #Production.Maintenance;
   #PartDataInvalid := #Production.PartDataInvalid;
   #DispositionDone := #Production.DispositionDone;
   #ResultCode := #Production.ResultCode;
   #FaultCode := #Production.FaultCode;
   #PlcState := #Production.State;
   #PlcReason := #Production.Reason;
   #PcAlive := #Production.PcAlive;
   #VisionAlarm := (#Production.State = 90) OR #Teaching.Faulted;
   #CaptureComplete := #Teaching.CaptureComplete;
   #CaptureFailed := #Teaching.CaptureFailed;
   #TeachState := #Teaching.State;
   #TeachReason := #Teaching.Reason;
END_FUNCTION_BLOCK
