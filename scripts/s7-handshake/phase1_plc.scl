// S7-1200/1500 接入参考，尚未在 TIA Portal 编译。握手协议 5（交互表 V1.1）。
// 两个标准 DB 均取消“优化的块访问”：GlueSightPlcArea 编号设为 DB4（PLC 写、PC 读，字节 0–89），
// GlueSightPcArea 编号设为 DB2（PC 写、PLC 读，字节 0–71）。生成块后核对编辑器偏移量列与协议第 2、3 节逐行一致。
// 16 位字段为 Int（只用 0–32767），SN 为 String[50]。本 FB 只写 DB4，不写 DB2。
DATA_BLOCK "GlueSightPlcArea"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   VAR
      partStart : Bool;
      partEnd : Bool;
      resultAck : Bool;
      faultReset : Bool;
      plcHeartbeat : Bool;
      reserved0_5 : Bool;
      reserved0_6 : Bool;
      reserved0_7 : Bool;
      reserved1 : Byte;
      protocolVersion : Int;
      requestSeq : DInt;
      productCode : Int;
      shotCount : Int;
      planVersion : DInt;
      planReserved : DInt;
      deviceShots : Int;
      reserved22 : Array[22..27] of Byte;
      ackSeq : DInt;
      deviceTriggers : Int;
      reserved34 : Array[34..37] of Byte;
      partSn : String[50];
   END_VAR
BEGIN
   protocolVersion := 5;
END_DATA_BLOCK

DATA_BLOCK "GlueSightPcArea"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   VAR
      visionReady : Bool;
      armed : Bool;
      busy : Bool;
      done : Bool;
      visionFault : Bool;
      pcHeartbeat : Bool;
      reserved0_6 : Bool;
      reserved0_7 : Bool;
      reserved1 : Byte;
      pcProtocolVersion : Int;
      resultSeq : DInt;
      resultCode : Int;
      faultCode : Int;
      acceptedSeq : DInt;
      acceptedPlanReserved : DInt;
      resultSn : String[50];
   END_VAR
END_DATA_BLOCK

FUNCTION_BLOCK "GlueSightPhase1"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      Startup : Bool;
      NewPart : Bool;
      ResetRequest : Bool;
      ReconcileConfirmed : Bool;
      PartSn : String[50];
      ProductCode : Int;
      PlanVersion : DInt;
      DeviceShots : Int;
      IssuedPulseCount : UDInt;
      MotionComplete : Bool;
      ExternalFault : Bool;
      ArmTimeout : Time := T#10s;
      MotionTimeout : Time := T#30s;
      ResultTimeout : Time := T#10s;
      ReleaseTimeout : Time := T#10s;
      ResetTimeout : Time := T#10s;
   END_VAR
   VAR_OUTPUT
      State : UInt := UINT#90;
      ReadyForPart : Bool;
      TriggerPermit : Bool;
      StopNewTriggers : Bool;
      PcAlive : Bool;
      Pending : Bool;
      ResetRequired : Bool;
      CycleComplete : Bool;
      ResetComplete : Bool;
      ResultLatched : Bool;
      CapturedResultSeq : DInt;
      CapturedResultSn : String[50];
      CapturedResultCode : Int;
      CapturedFaultCode : Int;
      LocalDiagnostic : UInt;
   END_VAR
   VAR
      Initialized : Bool;
      PreviousNewPart : Bool;
      PreviousReset : Bool;
      ResetLowSeen : Bool;
      PcHeartbeatPrevious : Bool;
      PcHeartbeatSeen : Bool;
      ResetReadyLowSeen : Bool;
      TimerState : UInt;
      FrozenSeq : DInt;
      FrozenSn : String[50];
      FrozenProductCode : Int;
      FrozenPlanVersion : DInt;
      FrozenShotCount : Int;
      FrozenDeviceShots : Int;
      CounterBase : UDInt;
      EndValidated : Bool;
      HeartbeatTimer : IEC_TIMER;
      PcWatchdog : IEC_TIMER;
      PhaseTimer : IEC_TIMER;
      NeutralTimer : IEC_TIMER;
      ResetHoldTimer : IEC_TIMER;
   END_VAR
   VAR_TEMP
      NewPartEdge : Bool;
      ResetEdge : Bool;
      PcHeartbeatChanged : Bool;
      PhaseTimed : Bool;
      PhaseLimit : Time;
      TripCode : UInt;
      Delta : UDInt;
      CurrentTriggers : Int;
      PayloadMatches : Bool;
      AcceptedMatches : Bool;
      ResultValid : Bool;
   END_VAR
BEGIN
   #CycleComplete := FALSE;
   #ResetComplete := FALSE;
   #TriggerPermit := FALSE;
   #ReadyForPart := FALSE;
   #TripCode := UINT#0;
   "GlueSightPlcArea".protocolVersion := INT#5;

   IF #Startup OR NOT #Initialized THEN
      #Initialized := TRUE;
      #State := UINT#90;
      #ResetLowSeen := FALSE;
      #PreviousReset := #ResetRequest;
      #PreviousNewPart := #NewPart;
      #PcHeartbeatPrevious := "GlueSightPcArea".pcHeartbeat;
      #PcHeartbeatSeen := FALSE;
      #ResetReadyLowSeen := FALSE;
      #Pending := #Pending OR "GlueSightPlcArea".partStart
         OR "GlueSightPlcArea".partEnd OR "GlueSightPlcArea".resultAck
         OR "GlueSightPcArea".armed OR "GlueSightPcArea".busy
         OR "GlueSightPcArea".done;
      #LocalDiagnostic := UINT#7000;
      "GlueSightPlcArea".faultReset := FALSE;
   END_IF;

   #HeartbeatTimer.TON(IN := NOT #HeartbeatTimer.Q, PT := T#500ms);
   IF #HeartbeatTimer.Q THEN
      "GlueSightPlcArea".plcHeartbeat := NOT "GlueSightPlcArea".plcHeartbeat;
   END_IF;

   #PcHeartbeatChanged := "GlueSightPcArea".pcHeartbeat <> #PcHeartbeatPrevious;
   IF #PcHeartbeatChanged THEN
      #PcHeartbeatSeen := TRUE;
   END_IF;
   #PcHeartbeatPrevious := "GlueSightPcArea".pcHeartbeat;
   #PcWatchdog.TON(IN := NOT #PcHeartbeatChanged AND NOT #Startup, PT := T#3s);
   #PcAlive := #PcHeartbeatSeen AND NOT #PcWatchdog.Q;

   IF NOT #ResetRequest THEN
      #ResetLowSeen := TRUE;
   END_IF;
   #ResetEdge := #ResetRequest AND NOT #PreviousReset AND #ResetLowSeen;
   #NewPartEdge := #NewPart AND NOT #PreviousNewPart;
   #PreviousReset := #ResetRequest;
   #PreviousNewPart := #NewPart;

   #PhaseLimit := #ReleaseTimeout;
   CASE #State OF
      20: #PhaseLimit := #ArmTimeout;
      30: #PhaseLimit := #MotionTimeout;
      40: #PhaseLimit := #ResultTimeout;
      91, 92: #PhaseLimit := #ResetTimeout;
   END_CASE;
   #PhaseTimed := (#State = UINT#20) OR (#State = UINT#30)
      OR (#State = UINT#40) OR (#State = UINT#50)
      OR (#State = UINT#60) OR (#State = UINT#91) OR (#State = UINT#92);
   #PhaseTimer.TON(IN := #PhaseTimed AND (#TimerState = #State), PT := #PhaseLimit);
   #TimerState := #State;
   #NeutralTimer.TON(IN := (#State = UINT#91) AND #PcAlive
      AND NOT "GlueSightPlcArea".partStart AND NOT "GlueSightPlcArea".partEnd
      AND NOT "GlueSightPlcArea".resultAck AND NOT "GlueSightPlcArea".faultReset,
      PT := T#1s);
   #ResetHoldTimer.TON(IN := (#State = UINT#92), PT := T#500ms);

   #PayloadMatches := ("GlueSightPlcArea".requestSeq = #FrozenSeq)
      AND ("GlueSightPlcArea".partSn = #FrozenSn)
      AND ("GlueSightPlcArea".productCode = #FrozenProductCode)
      AND ("GlueSightPlcArea".planVersion = #FrozenPlanVersion)
      AND ("GlueSightPlcArea".shotCount = #FrozenShotCount)
      AND ("GlueSightPlcArea".deviceShots = #FrozenDeviceShots);
   #AcceptedMatches := ("GlueSightPcArea".acceptedSeq = #FrozenSeq);

   IF #State <> UINT#90 THEN
      IF #PcWatchdog.Q THEN
         #TripCode := UINT#7001;
      ELSIF #ExternalFault THEN
         #TripCode := UINT#7009;
      ELSIF #PhaseTimer.Q THEN
         #TripCode := UINT#7003;
      ELSIF (#State < UINT#90) AND "GlueSightPcArea".visionFault THEN
         #TripCode := UINT#7002;
      ELSIF (#State >= UINT#20) AND (#State <= UINT#50)
         AND (NOT #PayloadMatches OR NOT "GlueSightPlcArea".partStart) THEN
         #TripCode := UINT#7008;
      END_IF;
   END_IF;

   IF #TripCode = UINT#0 THEN
      CASE #State OF
         10:
            IF #ResetEdge AND #ReconcileConfirmed AND #PcAlive THEN
               "GlueSightPlcArea".partStart := FALSE;
               "GlueSightPlcArea".partEnd := FALSE;
               "GlueSightPlcArea".resultAck := FALSE;
               "GlueSightPlcArea".faultReset := FALSE;
               #State := UINT#91;
            ELSIF #NewPartEdge AND #PcAlive AND "GlueSightPcArea".visionReady
               AND NOT "GlueSightPcArea".armed AND NOT "GlueSightPcArea".busy
               AND NOT "GlueSightPcArea".done AND NOT "GlueSightPcArea".visionFault
               AND NOT "GlueSightPlcArea".partStart AND NOT "GlueSightPlcArea".partEnd
               AND NOT "GlueSightPlcArea".resultAck THEN
               IF (#DeviceShots <= INT#0) OR (#PlanVersion <= DINT#0)
                  OR #MotionComplete OR ("GlueSightPcArea".pcProtocolVersion <> INT#5) THEN
                  #TripCode := UINT#7004;
               ELSIF ("GlueSightPlcArea".requestSeq >= DINT#2147483647) OR ("GlueSightPlcArea".requestSeq < DINT#0) THEN
                  #TripCode := UINT#7007;
               ELSE
                  #FrozenSeq := "GlueSightPlcArea".requestSeq + DINT#1;
                  #FrozenSn := #PartSn;
                  #FrozenProductCode := #ProductCode;
                  #FrozenPlanVersion := #PlanVersion;
                  #FrozenShotCount := #DeviceShots;
                  #FrozenDeviceShots := #DeviceShots;
                  "GlueSightPlcArea".requestSeq := #FrozenSeq;
                  "GlueSightPlcArea".partSn := #FrozenSn;
                  "GlueSightPlcArea".productCode := #FrozenProductCode;
                  "GlueSightPlcArea".shotCount := #FrozenShotCount;
                  "GlueSightPlcArea".planVersion := #FrozenPlanVersion;
                  "GlueSightPlcArea".planReserved := DINT#0;
                  "GlueSightPlcArea".deviceShots := #FrozenDeviceShots;
                  "GlueSightPlcArea".deviceTriggers := INT#0;
                  "GlueSightPlcArea".ackSeq := DINT#0;
                  "GlueSightPlcArea".partEnd := FALSE;
                  "GlueSightPlcArea".resultAck := FALSE;
                  "GlueSightPlcArea".faultReset := FALSE;
                   #Pending := TRUE;
                   #ResultLatched := FALSE;
                   #EndValidated := FALSE;
                   "GlueSightPlcArea".partStart := TRUE;
                  #State := UINT#20;
               END_IF;
            END_IF;
         20:
             IF "GlueSightPcArea".done THEN
                IF "GlueSightPcArea".resultCode = INT#90 THEN
                   #State := UINT#40;
                ELSE
                   #TripCode := UINT#7005;
                END_IF;
            ELSIF "GlueSightPcArea".armed THEN
               IF NOT #AcceptedMatches OR NOT "GlueSightPcArea".busy
                  OR "GlueSightPcArea".visionReady THEN
                  #TripCode := UINT#7005;
               ELSE
                  #CounterBase := #IssuedPulseCount;
                  #State := UINT#30;
               END_IF;
            END_IF;
         30:
             IF NOT "GlueSightPcArea".busy OR NOT #AcceptedMatches THEN
                #TripCode := UINT#7005;
             ELSIF NOT "GlueSightPcArea".armed THEN
                #State := UINT#40;
             ELSIF "GlueSightPcArea".done THEN
                #TripCode := UINT#7005;
            ELSE
               IF #IssuedPulseCount < #CounterBase THEN
                  #TripCode := UINT#7006;
               ELSE
                  #Delta := #IssuedPulseCount - #CounterBase;
                  IF #Delta > INT_TO_UDINT(#FrozenDeviceShots) THEN
                     #TripCode := UINT#7006;
                  ELSE
                     #CurrentTriggers := UDINT_TO_INT(#Delta);
                  END_IF;
               END_IF;
               IF #TripCode = UINT#0 THEN
                  "GlueSightPlcArea".deviceTriggers := #CurrentTriggers;
                  IF #MotionComplete THEN
                     IF #CurrentTriggers <> #FrozenDeviceShots THEN
                        #TripCode := UINT#7006;
                      ELSE
                         #EndValidated := TRUE;
                         "GlueSightPlcArea".partEnd := TRUE;
                        #State := UINT#40;
                     END_IF;
                  END_IF;
               END_IF;
            END_IF;
         40:
            IF "GlueSightPcArea".done THEN
                #ResultValid := ("GlueSightPcArea".resultSeq = #FrozenSeq)
                   AND ("GlueSightPcArea".resultSn = #FrozenSn)
                   AND NOT "GlueSightPcArea".armed
                   AND "GlueSightPcArea".busy AND NOT "GlueSightPcArea".visionReady
                  AND (("GlueSightPcArea".resultCode = INT#1)
                  OR ("GlueSightPcArea".resultCode = INT#2)
                  OR ("GlueSightPcArea".resultCode = INT#11)
                  OR ("GlueSightPcArea".resultCode = INT#12)
                  OR ("GlueSightPcArea".resultCode = INT#13)
                  OR ("GlueSightPcArea".resultCode = INT#14)
                  OR ("GlueSightPcArea".resultCode = INT#90))
                  AND ((("GlueSightPcArea".resultCode = INT#90)
                  AND ("GlueSightPcArea".faultCode >= INT#91)
                   AND ("GlueSightPcArea".faultCode <= INT#100))
                   OR (("GlueSightPcArea".resultCode <> INT#90)
                   AND ("GlueSightPcArea".faultCode = INT#0)
                   AND #EndValidated AND "GlueSightPlcArea".partEnd));
               IF NOT #ResultValid THEN
                  #TripCode := UINT#7005;
               ELSE
                  #CapturedResultSeq := "GlueSightPcArea".resultSeq;
                  #CapturedResultSn := "GlueSightPcArea".resultSn;
                  #CapturedResultCode := "GlueSightPcArea".resultCode;
                  #CapturedFaultCode := "GlueSightPcArea".faultCode;
                  #ResultLatched := TRUE;
                  "GlueSightPlcArea".ackSeq := #CapturedResultSeq;
                  "GlueSightPlcArea".resultAck := TRUE;
                  #State := UINT#50;
               END_IF;
            END_IF;
         50:
            IF "GlueSightPcArea".done AND
               (("GlueSightPcArea".resultSeq <> #CapturedResultSeq)
               OR ("GlueSightPcArea".resultSn <> #CapturedResultSn)
               OR ("GlueSightPcArea".resultCode <> #CapturedResultCode)
               OR ("GlueSightPcArea".faultCode <> #CapturedFaultCode)) THEN
               #TripCode := UINT#7005;
            ELSIF NOT "GlueSightPcArea".busy AND NOT "GlueSightPcArea".done THEN
               "GlueSightPlcArea".partStart := FALSE;
               "GlueSightPlcArea".partEnd := FALSE;
               "GlueSightPlcArea".resultAck := FALSE;
               #State := UINT#60;
            END_IF;
         60:
            IF "GlueSightPcArea".visionReady AND NOT "GlueSightPcArea".armed
               AND NOT "GlueSightPcArea".busy AND NOT "GlueSightPcArea".done THEN
               #Pending := FALSE;
               #CycleComplete := TRUE;
               #LocalDiagnostic := UINT#0;
               #State := UINT#10;
            END_IF;
         90:
            IF #ResetEdge AND #ReconcileConfirmed AND #PcAlive AND NOT #ExternalFault THEN
               "GlueSightPlcArea".partStart := FALSE;
               "GlueSightPlcArea".partEnd := FALSE;
               "GlueSightPlcArea".resultAck := FALSE;
               "GlueSightPlcArea".faultReset := FALSE;
               #ResetReadyLowSeen := FALSE;
               #State := UINT#91;
            END_IF;
         91:
            IF #NeutralTimer.Q THEN
               #ResetReadyLowSeen := NOT "GlueSightPcArea".visionReady;
               "GlueSightPlcArea".faultReset := TRUE;
               #State := UINT#92;
            END_IF;
         92:
            IF NOT "GlueSightPcArea".visionReady THEN
               #ResetReadyLowSeen := TRUE;
            END_IF;
            IF #ResetReadyLowSeen AND #ResetHoldTimer.Q AND #PcAlive
               AND "GlueSightPcArea".visionReady
               AND ("GlueSightPcArea".pcProtocolVersion = INT#5)
               AND NOT "GlueSightPcArea".armed AND NOT "GlueSightPcArea".busy
               AND NOT "GlueSightPcArea".done AND NOT "GlueSightPcArea".visionFault THEN
               "GlueSightPlcArea".faultReset := FALSE;
               #Pending := FALSE;
               #LocalDiagnostic := UINT#0;
               #ResetComplete := TRUE;
               #State := UINT#10;
            END_IF;
         ELSE
            #TripCode := UINT#7000;
      END_CASE;
   END_IF;

   IF #TripCode <> UINT#0 THEN
      #LocalDiagnostic := #TripCode;
      #State := UINT#90;
      #ResetLowSeen := FALSE;
      #PreviousReset := #ResetRequest;
      #PcHeartbeatSeen := FALSE;
      #ResetReadyLowSeen := FALSE;
      "GlueSightPlcArea".faultReset := FALSE;
   END_IF;

   #ReadyForPart := (#State = UINT#10) AND #PcAlive
      AND "GlueSightPcArea".visionReady AND NOT "GlueSightPcArea".visionFault
      AND ("GlueSightPcArea".pcProtocolVersion = INT#5)
      AND NOT "GlueSightPcArea".armed AND NOT "GlueSightPcArea".busy
      AND NOT "GlueSightPcArea".done AND NOT "GlueSightPlcArea".partStart
      AND NOT "GlueSightPlcArea".partEnd AND NOT "GlueSightPlcArea".resultAck
      AND NOT #Pending AND NOT #ExternalFault;
   #TriggerPermit := (#State = UINT#30) AND #PcAlive AND NOT #ExternalFault
      AND "GlueSightPcArea".armed AND "GlueSightPcArea".busy
      AND #AcceptedMatches AND NOT "GlueSightPcArea".visionFault
      AND NOT "GlueSightPlcArea".partEnd;
   #StopNewTriggers := NOT #TriggerPermit;
   #ResetRequired := #State >= UINT#90;
END_FUNCTION_BLOCK
