{
  "compilerOptions": {
    "composite": true,
    "outDir": "./output/.cache/typescript/config",
    "tsBuildInfoFile": "./output/.cache/typescript/config.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
