{
  "name": "gluesight",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "pwsh -NoProfile -File scripts/Start-Dev.ps1",
    "storage:init": "pwsh -NoProfile -File scripts/Initialize-Storage.ps1",
    "dev:joint": "pwsh -NoProfile -File scripts/Start-JointDev.ps1",
    "dev:web": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "package": "pwsh -NoProfile -File scripts/Package-Windows.ps1",
    "package:deps": "pwsh -NoProfile -File scripts/Export-RuntimeDependencies.ps1",
    "package:deps:publish": "pwsh -NoProfile -File scripts/Publish-RuntimeDependencies.ps1",
    "deps:lyflow:update": "pwsh -NoProfile -File scripts/Update-LyFlowDependency.ps1",
    "deps:lyflow:restore": "pwsh -NoProfile -File scripts/Restore-LyFlowRuntime.ps1",
    "deps:lyflow:dev": "pwsh -NoProfile -File scripts/Install-DevLyFlowRuntime.ps1",
    "deps:lyflow:local": "pwsh -NoProfile -File scripts/Set-LocalLyFlowRuntime.ps1",
    "version:check": "pwsh -NoProfile -File scripts/Test-PackageVersions.ps1",
    "version:set": "pwsh -NoProfile -File scripts/Set-PackageVersion.ps1",
    "test": "vitest run",
    "test:watch": "vitest",
    "samples:test": "python -m unittest discover -s scripts/sample-set/tests -v",
    "test:ui:production": "pwsh -NoProfile -File scripts/Test-UiProductionFlow.ps1",
    "test:soak": "pwsh -NoProfile -File scripts/Test-Soak.ps1",
    "test:soak:throughput": "pwsh -NoProfile -File scripts/Test-Soak.ps1 -Stages throughput",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview --config vite.config.ts",
    "tauri": "tauri",
    "test:desktop:build": "pwsh -NoProfile -File scripts/Build-UiTestInstance.ps1"
  },
  "dependencies": {
    "@lyflow/editor": "https://github.com/liangyuR/lyFlow/releases/download/v1.2.0/lyflow-editor-v1.2.0.tgz",
    "@tauri-apps/api": "^2.12.4",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.48.0",
    "qing-steel": "https://github.com/liangyuR/qing-steel/releases/download/v0.10.0/qing-steel-0.10.0.tgz",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.169.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "mermaid": "11.17.2",
    "playwright-core": "1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
