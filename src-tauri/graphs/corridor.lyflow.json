{
  "schemaVersion": 1,
  "id": "01GLUESIGHTCORRIDOR000000",
  "nodes": [
    {"id": "n_load", "op": "io.load_image", "params": {"source": "inputs"}},
    {"id": "n_resp", "op": "glue.response", "params": {}},
    {"id": "n_line", "op": "glue.polyline", "params": {"zone": [0.0, 0.0]}},
    {"id": "n_runs", "op": "glue.lateral_runs", "params": {"split": "half_max", "mergePeakRatio": 0.4}},
    {"id": "n_split", "op": "glue.lateral_runs", "params": {"split": "half_max", "mergePeakRatio": 0.4, "mergeGap": 0.0}},
    {"id": "n_edge", "op": "glue.part_edges", "params": {"sides": "both", "start": 0.0}}
  ],
  "edges": [
    {"id": "e_resp", "from": {"node": "n_load", "port": "image"}, "to": {"node": "n_resp", "port": "image"}},
    {"id": "e_r_resp", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_runs", "port": "maps"}},
    {"id": "e_r_line", "from": {"node": "n_line", "port": "line"}, "to": {"node": "n_runs", "port": "line"}},
    {"id": "e_s_resp", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_split", "port": "maps"}},
    {"id": "e_s_line", "from": {"node": "n_line", "port": "line"}, "to": {"node": "n_split", "port": "line"}},
    {"id": "e_e_image", "from": {"node": "n_load", "port": "image"}, "to": {"node": "n_edge", "port": "image"}},
    {"id": "e_e_line", "from": {"node": "n_line", "port": "line"}, "to": {"node": "n_edge", "port": "line"}}
  ],
  "outputs": {
    "runs": {"node": "n_runs", "port": "runs"},
    "split": {"node": "n_split", "port": "runs"},
    "edges": {"node": "n_edge", "port": "edges"}
  },
  "params": {
    "points": {"default": "[[0,0],[100,0]]", "binds": ["n_line.points"], "doc": "示教走廊（JSON 点列，px）"},
    "polarity": {"default": "dark", "binds": ["n_resp.polarity"]},
    "diameter": {"default": 25, "binds": ["n_resp.diameter"], "doc": "响应图结构元直径（px）= 胶宽上限取整 + 1"},
    "roi": {"default": [0, 0, 0, 0], "binds": ["n_resp.roi"], "doc": "响应图只算的块 [x, y, w, h]（px）：走廊包围盒外扩卡尺半长 + 4"},
    "stationStep": {"default": 4.0, "binds": ["n_runs.stationStep", "n_split.stationStep", "n_edge.stationStep"], "doc": "站距（px）"},
    "searchHalf": {"default": 32.0, "binds": ["n_runs.searchHalf", "n_split.searchHalf"], "doc": "卡尺半长（px）：不小于中心偏移容差 + 胶宽上限的一半"},
    "widthMax": {"default": 24.0, "binds": ["n_runs.mergeWidthMax", "n_split.mergeWidthMax"], "doc": "胶宽上限（px）：合并后不宽于它"},
    "edgeLength": {"default": 200.0, "binds": ["n_edge.searchLength"], "doc": "找边剖面长度（px，从胶路起）：盖住卡尺半长外的整个找边窗口"},
    "edgePolarity": {"default": "bright_to_dark", "binds": ["n_edge.polarity"]},
    "edgeContrastMin": {"default": 40.0, "binds": ["n_edge.contrastMin"], "doc": "找边对比度下限"},
    "edgeFarRun": {"default": 12.0, "binds": ["n_edge.farRun"], "doc": "找边远侧持续长度（px）"},
    "segmentMin": {"type": "float", "label": "分段门限", "min": 0.0, "max": 255.0, "step": 1.0, "default": 8.0, "advanced": true, "group": "量胶宽", "binds": ["n_runs.segmentMin", "n_split.segmentMin"], "doc": "卡尺上响应高于它的相邻采样连成一段"},
    "peakMin": {"type": "float", "label": "峰值下限", "min": 0.0, "max": 255.0, "step": 1.0, "default": 16.0, "advanced": true, "group": "量胶宽", "binds": ["n_runs.peakMin", "n_split.peakMin"], "doc": "一段（及半高子段）的响应峰值至少这么高才算暗段"},
    "mergeGap": {"type": "float", "label": "合并缝", "unit": "px", "min": 0.0, "max": 100.0, "step": 1.0, "default": 8.0, "advanced": true, "group": "量胶宽", "binds": ["n_runs.mergeGap"], "doc": "暗段之间的缝不超过它、合并后不宽于胶宽上限就合并"}
  },
  "x": {
    "gluesight": {
      "judge": {
        "trackSharpMin": {"type": "float", "label": "示教线陡度下限", "min": 0.0, "max": 5.0, "step": 0.05, "default": 0.4, "advanced": true, "group": "定胶路", "doc": "示教线上暗带边缘陡度 P25 低于它，整条判没有胶（像压痕或阴影）"},
        "presentRatio": {"type": "float", "label": "有胶宽度比", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.5, "advanced": true, "group": "量胶宽", "doc": "宽度不小于参考宽的这一比例才算有胶"},
        "centerRatio": {"type": "float", "label": "中心偏离比", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3, "advanced": true, "group": "量胶宽", "doc": "中心偏离胶路不超过 max(6, 它 × 参考宽)"},
        "contrastRatio": {"type": "float", "label": "对比度比", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3, "advanced": true, "group": "量胶宽", "doc": "峰值（示教走廊用峰值 / 局部亮度）不低于参考值的这一比例才算有胶"}
      }
    }
  }
}
