      }
    },
    {
      "id": "e17",
      "from": {
        "node": "n_t1",
        "port": "line"
      },
      "to": {
        "node": "n_e1",
        "port": "line"
      }
    },
    {
      "id": "e18",
      "from": {
        "node": "n_map",
        "port": "maps"
      },
      "to": {
        "node": "n_t2",
        "port": "maps"
      }
    },
    {
      "id": "e20",
      "from": {
        "node": "n_fan",
        "port": "scan"
      },
      "to": {
        "node": "n_t2",
