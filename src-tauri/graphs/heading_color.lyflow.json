{
  "schemaVersion": 1,
  "id": "01GLUESIGHTHEADINGCOLOR00",
  "nodes": [
    {
      "id": "n_load",
      "op": "io.load_image",
      "params": {
        "source": "inputs"
      }
    },
    {
      "id": "n_map",
      "op": "glue.color_map",
      "params": {}
    },
    {
      "id": "n_fan",
      "op": "glue.color_fan",
      "params": {
        "includeInvalid": true
      }
    },
    {
      "id": "n_t0",
      "op": "glue.color_track",
      "params": {
        "peakIndex": 0,
        "minPoints": 3,
        "split": "half_max"
      }
    },
    {
      "id": "n_r0",
      "op": "glue.color_runs",
      "params": {
        "split": "half_max"
      }
    },
    {
      "id": "n_e0",
      "op": "glue.part_edges",
      "params": {
        "sides": "both",
        "start": 0.0
      }
    },
    {
      "id": "n_t1",
      "op": "glue.color_track",
      "params": {
        "peakIndex": 1,
        "minPoints": 3,
        "split": "half_max"
      }
    },
    {
      "id": "n_r1",
      "op": "glue.color_runs",
      "params": {
        "split": "half_max"
      }
    },
    {
      "id": "n_e1",
      "op": "glue.part_edges",
      "params": {
        "sides": "both",
        "start": 0.0
      }
    },
    {
      "id": "n_t2",
      "op": "glue.color_track",
      "params": {
        "peakIndex": 2,
        "minPoints": 3,
        "split": "half_max"
      }
    },
    {
      "id": "n_r2",
      "op": "glue.color_runs",
      "params": {
        "split": "half_max"
      }
    },
    {
      "id": "n_e2",
      "op": "glue.part_edges",
      "params": {
        "sides": "both",
        "start": 0.0
      }
    }
  ],
  "edges": [
