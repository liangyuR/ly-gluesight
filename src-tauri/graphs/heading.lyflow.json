{
  "schemaVersion": 1,
  "id": "01GLUESIGHTHEADING0000000",
  "nodes": [
    {"id": "n_load", "op": "io.load_image", "params": {"source": "inputs"}},
    {"id": "n_resp", "op": "glue.response", "params": {}},
    {"id": "n_fan", "op": "glue.fan_scan", "params": {"includeInvalid": true}},
    {"id": "n_t0", "op": "glue.track_path", "params": {"peakIndex": 0, "minPoints": 3, "split": "half_max", "mergePeakRatio": 0.4}},
    {"id": "n_r0", "op": "glue.lateral_runs", "params": {"split": "half_max", "mergePeakRatio": 0.0}},
    {"id": "n_e0", "op": "glue.part_edges", "params": {"sides": "both", "start": 0.0}},
    {"id": "n_t1", "op": "glue.track_path", "params": {"peakIndex": 1, "minPoints": 3, "split": "half_max", "mergePeakRatio": 0.4}},
    {"id": "n_r1", "op": "glue.lateral_runs", "params": {"split": "half_max", "mergePeakRatio": 0.0}},
    {"id": "n_e1", "op": "glue.part_edges", "params": {"sides": "both", "start": 0.0}},
    {"id": "n_t2", "op": "glue.track_path", "params": {"peakIndex": 2, "minPoints": 3, "split": "half_max", "mergePeakRatio": 0.4}},
    {"id": "n_r2", "op": "glue.lateral_runs", "params": {"split": "half_max", "mergePeakRatio": 0.0}},
    {"id": "n_e2", "op": "glue.part_edges", "params": {"sides": "both", "start": 0.0}}
  ],
  "edges": [
    {"id": "e0", "from": {"node": "n_load", "port": "image"}, "to": {"node": "n_resp", "port": "image"}},
    {"id": "e1", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_fan", "port": "maps"}},
    {"id": "e2", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_t0", "port": "maps"}},
    {"id": "e4", "from": {"node": "n_fan", "port": "scan"}, "to": {"node": "n_t0", "port": "fan"}},
    {"id": "e5", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_r0", "port": "maps"}},
    {"id": "e7", "from": {"node": "n_t0", "port": "line"}, "to": {"node": "n_r0", "port": "line"}},
    {"id": "e8", "from": {"node": "n_load", "port": "image"}, "to": {"node": "n_e0", "port": "image"}},
    {"id": "e9", "from": {"node": "n_t0", "port": "line"}, "to": {"node": "n_e0", "port": "line"}},
    {"id": "e10", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_t1", "port": "maps"}},
    {"id": "e12", "from": {"node": "n_fan", "port": "scan"}, "to": {"node": "n_t1", "port": "fan"}},
    {"id": "e13", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_r1", "port": "maps"}},
    {"id": "e15", "from": {"node": "n_t1", "port": "line"}, "to": {"node": "n_r1", "port": "line"}},
    {"id": "e16", "from": {"node": "n_load", "port": "image"}, "to": {"node": "n_e1", "port": "image"}},
    {"id": "e17", "from": {"node": "n_t1", "port": "line"}, "to": {"node": "n_e1", "port": "line"}},
    {"id": "e18", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_t2", "port": "maps"}},
    {"id": "e20", "from": {"node": "n_fan", "port": "scan"}, "to": {"node": "n_t2", "port": "fan"}},
    {"id": "e21", "from": {"node": "n_resp", "port": "maps"}, "to": {"node": "n_r2", "port": "maps"}},
    {"id": "e23", "from": {"node": "n_t2", "port": "line"}, "to": {"node": "n_r2", "port": "line"}},
    {"id": "e24", "from": {"node": "n_load", "port": "image"}, "to": {"node": "n_e2", "port": "image"}},
    {"id": "e25", "from": {"node": "n_t2", "port": "line"}, "to": {"node": "n_e2", "port": "line"}}
  ],
  "outputs": {
    "scan": {"node": "n_fan", "port": "scan"},
    "track0": {"node": "n_t0", "port": "track"},
    "line0": {"node": "n_t0", "port": "line"},
    "runs0": {"node": "n_r0", "port": "runs"},
    "edges0": {"node": "n_e0", "port": "edges"},
    "track1": {"node": "n_t1", "port": "track"},
    "line1": {"node": "n_t1", "port": "line"},
    "runs1": {"node": "n_r1", "port": "runs"},
    "edges1": {"node": "n_e1", "port": "edges"},
    "track2": {"node": "n_t2", "port": "track"},
    "line2": {"node": "n_t2", "port": "line"},
    "runs2": {"node": "n_r2", "port": "runs"},
    "edges2": {"node": "n_e2", "port": "edges"}
  },
  "params": {
    "nozzle": {"default": [0.0, 0.0], "binds": ["n_fan.anchor", "n_t0.anchor", "n_t1.anchor", "n_t2.anchor"], "doc": "出胶点（px）"},
    "zone": {"default": [0.0, 100.0], "binds": ["n_t0.zone", "n_t1.zone", "n_t2.zone"], "doc": "检测区：距出胶点的弧长区间（px）"},
    "radial": {"default": [0.0, 100.0], "binds": ["n_fan.radial"], "doc": "扇形扫描的径向区间（px）：检测区前段，最长 150 px"},
    "sector": {"default": [-180.0, 180.0], "binds": ["n_fan.sector", "n_t0.bearingRange", "n_t1.bearingRange", "n_t2.bearingRange"], "doc": "扇形搜索的方向范围（度）"},
    "polarity": {"default": "dark", "binds": ["n_resp.polarity"]},
    "diameter": {"default": 25, "binds": ["n_resp.diameter"], "doc": "响应图结构元直径（px）= 胶宽上限取整 + 1"},
    "roi": {"default": [0, 0, 0, 0], "binds": ["n_resp.roi"], "doc": "响应图只算的块 [x, y, w, h]（px）：出胶点 ± 检测区外沿 + max(胶宽上限 + 8, 卡尺半长 + 5)"},
    "pathWidthMax": {"default": 24.0, "binds": ["n_t0.widthMax", "n_t1.widthMax", "n_t2.widthMax", "n_t0.searchHalf", "n_t1.searchHalf", "n_t2.searchHalf", "n_t0.mergeWidthMax", "n_t1.mergeWidthMax", "n_t2.mergeWidthMax"], "doc": "粗跟踪的胶宽上限取整（px），也是粗跟踪的卡尺半长"},
    "stationStep": {"default": 4.0, "binds": ["n_r0.stationStep", "n_r1.stationStep", "n_r2.stationStep", "n_e0.stationStep", "n_e1.stationStep", "n_e2.stationStep"], "doc": "站距（px）"},
    "searchHalf": {"default": 32.0, "binds": ["n_r0.searchHalf", "n_r1.searchHalf", "n_r2.searchHalf"], "doc": "卡尺半长（px）"},
    "widthMax": {"default": 24.0, "binds": ["n_r0.mergeWidthMax", "n_r1.mergeWidthMax", "n_r2.mergeWidthMax"], "doc": "胶宽上限（px）：合并后不宽于它"},
    "edgeLength": {"default": 200.0, "binds": ["n_e0.searchLength", "n_e1.searchLength", "n_e2.searchLength"], "doc": "找边剖面长度（px，从胶路起）：盖住卡尺半长外的整个找边窗口"},
    "edgePolarity": {"default": "bright_to_dark", "binds": ["n_e0.polarity", "n_e1.polarity", "n_e2.polarity"]},
    "edgeContrastMin": {"default": 40.0, "binds": ["n_e0.contrastMin", "n_e1.contrastMin", "n_e2.contrastMin"], "doc": "找边对比度下限"},
    "edgeFarRun": {"default": 12.0, "binds": ["n_e0.farRun", "n_e1.farRun", "n_e2.farRun"], "doc": "找边远侧持续长度（px）"},
    "segmentMin": {"type": "float", "label": "分段门限", "min": 0.0, "max": 255.0, "step": 1.0, "default": 8.0, "advanced": true, "group": "量胶宽", "binds": ["n_r0.segmentMin", "n_r1.segmentMin", "n_r2.segmentMin"], "doc": "卡尺上响应高于它的相邻采样连成一段"},
    "peakMin": {"type": "float", "label": "峰值下限", "min": 0.0, "max": 255.0, "step": 1.0, "default": 16.0, "advanced": true, "group": "量胶宽", "binds": ["n_r0.peakMin", "n_r1.peakMin", "n_r2.peakMin"], "doc": "一段（及半高子段）的响应峰值至少这么高才算暗段"},
    "mergeGap": {"type": "float", "label": "合并缝", "unit": "px", "min": 0.0, "max": 100.0, "step": 1.0, "default": 8.0, "advanced": true, "group": "量胶宽", "binds": ["n_r0.mergeGap", "n_r1.mergeGap", "n_r2.mergeGap"], "doc": "暗段之间的缝不超过它、合并后不宽于胶宽上限就合并"},
    "pathSegmentMin": {"type": "float", "label": "定向分段门限", "min": 0.0, "max": 255.0, "step": 1.0, "default": 8.0, "advanced": true, "group": "定胶路", "binds": ["n_t0.segmentMin", "n_t1.segmentMin", "n_t2.segmentMin"], "doc": "粗跟踪时卡尺上响应高于它的相邻采样连成一段"},
    "pathPeakMin": {"type": "float", "label": "定向峰值下限", "min": 0.0, "max": 255.0, "step": 1.0, "default": 16.0, "advanced": true, "group": "定胶路", "binds": ["n_t0.peakMin", "n_t1.peakMin", "n_t2.peakMin"], "doc": "粗跟踪时一段响应的峰值至少这么高才算胶"},
    "pathMaxGap": {"type": "float", "label": "定向最长断口", "unit": "px", "min": 0.0, "max": 1000.0, "step": 1.0, "default": 120.0, "advanced": true, "group": "定胶路", "binds": ["n_t0.maxGap", "n_t1.maxGap", "n_t2.maxGap"], "doc": "粗跟踪时连续没找到胶超过它就不再接受新的胶点"},
    "pathSharpMin": {"type": "float", "label": "定向陡度下限", "min": 0.0, "max": 5.0, "step": 0.05, "default": 0.4, "advanced": true, "group": "定胶路", "binds": ["n_t0.sharpMin", "n_t1.sharpMin", "n_t2.sharpMin"], "doc": "粗跟踪断口后重新接上的胶点、选中方向的暗带边缘陡度 P25 都要不低于它；选中方向低于它算不像胶、没找到胶条"}
  },
  "x": {
    "gluesight": {
      "judge": {
        "minCoverage": {"type": "float", "label": "定向覆盖率下限", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3, "advanced": true, "group": "定胶路", "doc": "选中方向粗找到胶的步数占比低于它就算没找到胶条"},
        "presentRatio": {"type": "float", "label": "有胶宽度比", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.5, "advanced": true, "group": "量胶宽", "doc": "宽度不小于参考宽的这一比例才算有胶"},
        "centerRatio": {"type": "float", "label": "中心偏离比", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3, "advanced": true, "group": "量胶宽", "doc": "中心偏离胶路不超过 max(6, 它 × 参考宽)"},
        "contrastRatio": {"type": "float", "label": "对比度比", "min": 0.0, "max": 1.0, "step": 0.05, "default": 0.3, "advanced": true, "group": "量胶宽", "doc": "峰值（示教走廊用峰值 / 局部亮度）不低于参考值的这一比例才算有胶"}
      }
    }
  }
}
